{
  "name": "@wom/spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "build": "tsc --noEmit && vite build && node scripts/strip-private.mjs",
    "typecheck": "tsc --noEmit",
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "android:build": "npm run build && npx cap sync android",
    "typecheck:electron": "tsc -p electron --noEmit",
    "electron:build": "npm run typecheck:electron && node scripts/electron-build.mjs",
    "electron:dev": "npm run build && npm run electron:build && electron .",
    "electron:pack": "npm run build && npm run electron:build && node scripts/electron-pack.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@mediapipe/tasks-vision": "1.2",
    "@wom/core": "*"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@electron/packager": "20.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "electron": "45.2.2",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "main": "electron-dist/main.cjs"
}
